[Unit]
Description=Lugh
Documentation=file:///usr/local/share/lugh/docs/architecture.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The config ships verbatim from the repository. Only the deployment facts are overridden
# here: the privileged port, the installed certificate pair and the state directory.
ExecStart=/usr/local/bin/lugh \
    --config /usr/local/etc/lugh/config.yaml \
    --port 443 \
    --tls-certificate /usr/local/etc/lugh/tls/cert.pem \
    --tls-key /usr/local/etc/lugh/tls/key.pem \
    --state-directory /var/lib/lugh

User=lugh
Group=lugh

Restart=on-failure
RestartSec=5s

# Port 443 (and 636, from P9) without root. Nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# /var/lib/lugh, made by systemd, 0700, the one place the service may write: the keyring
# now, the store from P3.
StateDirectory=lugh
StateDirectoryMode=0700

# The master key, never on disk in clear. `lugh init` makes it and systemd-creds seals it
# here, to the TPM where the host has one; systemd decrypts it at each start into a ramfs
# only this service can read, as $CREDENTIALS_DIRECTORY/lugh-master-key. Without it the
# unit does not start.
LoadCredentialEncrypted=lugh-master-key:/etc/credstore.encrypted/lugh-master-key

# Key material is locked into memory, a page or so per key.
LimitMEMLOCK=16M

# A core dump of an identity server is a copy of its keys. The process sets this too.
LimitCORE=0

MemoryMax=256M
TasksMax=64

# Hardening, after blackraven-admin's unit. Not PrivateUsers: a capability inside a user
# namespace does not bind the host's port 443.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
